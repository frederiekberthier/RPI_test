[Unit]
Description=Raspberry Pi tester: scherm en startknop
After=network.target NetworkManager.service bluetooth.service
Wants=NetworkManager.service bluetooth.service

[Service]
Type=simple
# Draait als root: de wifi-hotspot (nmcli), bluetooth en de GPIO-chip vragen die rechten.
# Extra opties (bv. --usb-fixture /etc/rpitest/usb_fixture.json) in /etc/rpitest/ui.env:
#   RPITEST_UI_ARGS=--usb-fixture /etc/rpitest/usb_fixture.json
EnvironmentFile=-/etc/rpitest/ui.env
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/var/lib/rpitest
ExecStart=/opt/rpitest/venv/bin/python -m rpitest.ui --reports /var/lib/rpitest/reports --allow-shutdown $RPITEST_UI_ARGS
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
